### Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

### Email (SMTP) - required for OTP by email
# Example (Gmail / Workspace):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL="Seven.AI <your-email@gmail.com>"

# Example (Brevo / Sendinblue):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-brevo-login
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL="Seven.AI <no-reply@seven.ai>"

# Example (Mailgun):
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=postmaster@mg.yourdomain.tld
# EMAIL_HOST_PASSWORD=your-mailgun-smtp-password
# DEFAULT_FROM_EMAIL="Seven.AI <no-reply@yourdomain.tld>"

EMAIL_TIMEOUT=20
# Copier : copy .env.example .env

# --- MariaDB (conteneur Nextcloud) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_nc
MYSQL_DATABASE=seven_cloud_db
MYSQL_USER=seven_user
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Nextcloud ---
NEXTCLOUD_URL=http://localhost:8085
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin
NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=change_me_or_app_password
NEXTCLOUD_ENABLED=false

# --- Django ---
DJANGO_USE_MYSQL=false
DJANGO_SECRET_KEY=change_me_django_secret_key_min_50_chars
ALLOWED_HOSTS=localhost,127.0.0.1
